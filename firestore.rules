rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /sessions/{sessionId} {
   // Código de convite aleatório de 12 caracteres é o identificador do documento.
   // Somente consultas diretas com o código são permitidas; listagem é proibida.
   allow get: if request.auth != null && (
     resource.data.ownerUid == request.auth.uid ||
     (resource.data.active == true && resource.data.expiresAt > request.time)
   );
   allow list: if false;
   allow create: if request.auth != null
     && request.resource.data.ownerUid == request.auth.uid
     && request.resource.data.active == true
     && request.resource.data.inviteCode == sessionId
     && sessionId.size() == 12;
   allow update: if request.auth != null
     && resource.data.ownerUid == request.auth.uid
     && request.resource.data.ownerUid == resource.data.ownerUid
     && request.resource.data.inviteCode == resource.data.inviteCode
     && request.resource.data.expiresAt == resource.data.expiresAt;
   allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
  }
 }
}
